// Prisma schema for Field Asset Maintenance Tracker (FAMT)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Admin
  Technician
  Viewer
}

enum AssetStatus {
  Active
  Under_maintenance @map("Under maintenance")
  Retired
}

enum TicketPriority {
  Low
  Medium
  High
  Critical
}

enum TicketStatus {
  Open
  In_progress @map("In progress")
  Resolved
  Closed
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role
  createdAt    DateTime  @default(now()) @map("created_at")

  // Relations
  assignedTickets Ticket[]  @relation("TicketAssignee")
  createdTickets  Ticket[]  @relation("TicketCreator")
  comments        Comment[]

  @@map("users")
}

model Site {
  id        String   @id @default(uuid())
  name      String
  location  String
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  assets Asset[]

  @@map("sites")
}

model Asset {
  id        String      @id @default(uuid())
  name      String
  type      String
  serialNo  String      @unique @map("serial_no")
  status    AssetStatus
  siteId    String      @map("site_id")
  createdAt DateTime    @default(now()) @map("created_at")

  // Relations
  site    Site     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  tickets Ticket[]

  @@map("assets")
}

model Ticket {
  id          String         @id @default(uuid())
  title       String
  description String
  priority    TicketPriority
  status      TicketStatus
  dueDate     DateTime       @map("due_date")
  assetId     String         @map("asset_id")
  assigneeId  String?        @map("assignee_id")
  createdBy   String         @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Relations
  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assignee User?     @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  User      @relation("TicketCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  comments Comment[]

  @@index([status, assigneeId])
  @@map("tickets")
}

model Comment {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  userId    String   @map("user_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("comments")
}
